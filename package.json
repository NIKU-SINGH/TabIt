{
  "name": "tabit",
  "displayName": "Tabit",
  "description": "Inline code completion with OpenAI, Anthropic, OpenRouter, and Together AI.",
  "version": "0.5.15",
  "publisher": "tabit",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test \"test/**/*.test.cjs\"",
    "vscode:prepublish": "npm test",
    "package": "vsce package --allow-missing-repository --skip-license --out Tabit.vsix",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "axios": "1.21.0"
  }
}
